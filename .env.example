# Frontend Environment Variables
VITE_BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Backend Environment Variables
ENVIRONMENT=development
AUTH_BYPASS=false
FACE_TOLERANCE=0.55
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Firebase Authentication Credentials (Use either file path or raw JSON string)
# Option 1: File path (mounted read-only in local Docker development)
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase.json

# Option 2: Raw JSON string (suitable for cloud hosting platforms like Railway/Vercel)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

